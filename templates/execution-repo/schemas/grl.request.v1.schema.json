{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/bohanyt/github-runner-local/schemas/grl.request.v1.schema.json",
  "title": "GRL request v1 JSON payload",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "request_id", "target", "profile", "expires_at", "timeout_minutes"],
  "properties": {
    "schema_version": { "const": "grl.request.v1" },
    "request_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "sha"],
      "properties": {
        "repository": {
          "type": "string",
          "pattern": "^[a-z0-9](?:[a-z0-9-]{0,37}[a-z0-9])?/[a-z0-9](?:[a-z0-9._-]{0,98}[a-z0-9])?$"
        },
        "sha": { "$ref": "#/$defs/gitSha" }
      }
    },
    "profile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "definition_sha"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9](?:[a-z0-9-]{0,62}[a-z0-9])?$"
        },
        "definition_sha": { "$ref": "#/$defs/gitSha" }
      }
    },
    "expires_at": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]{1,7})?Z$"
    },
    "timeout_minutes": { "type": "integer", "minimum": 1, "maximum": 1440 }
  },
  "$defs": {
    "gitSha": { "type": "string", "pattern": "^[0-9a-f]{40}$" }
  },
  "$comment": "Envelope, duplicate-key, allowlist, profile maximum, and expiry-window checks are enforced by the C# validator."
}
