{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/bohanyt/github-runner-local/schemas/grl.settings.v1.schema.json",
  "title": "GRL non-secret portable settings v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "mode"],
  "properties": {
    "schema_version": { "const": "grl.settings.v1" },
    "mode": { "const": "portable" },
    "disk_reserve_gib": {
      "type": "integer",
      "minimum": 1,
      "maximum": 1000000,
      "default": 15
    }
  },
  "$comment": "Secret-shaped values are additionally refused by the parser. This schema has no credential fields."
}
